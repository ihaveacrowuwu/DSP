# Base URL of the Go API. Leave blank in development to use the Vite proxy.
VITE_API_BASE_URL=

# Optional raster basemap under the sighting data, as an XYZ tile template.
# Left blank by default so the map is fully self-contained and works offline —
# the map style itself is defined in code, so sighting data always renders.
# Set this only to a keyless tile source; API-key services are not permitted.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
