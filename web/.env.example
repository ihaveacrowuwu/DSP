# Base URL of the Go API. Leave blank in development to use the Vite proxy.
VITE_API_BASE_URL=

# Optional raster basemap under the sighting data, as an XYZ tile template.
# Leave it blank: the map already draws real Maldives geography from
# public/basemap/maldives.json, with no tile server and no network. Set this only
# if you want imagery underneath, and only to a keyless source — API-key services
# are not permitted. When it is set the local water fills stand down (two
# basemaps stacked is worse than either) and the reef rims stay on over the
# imagery.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
