# Reference material not owned by this project.
# Matched with a trailing wildcard so a rename cannot reopen the hole.
#
#
# rename cannot reopen the hole.
/PROJECT INFO FILES*/
/coralsense-main

# Word and Office lock files. `~$name.docx` appears whenever a document is open
# and is never worth committing; one was already tracked.
~$*

# Build outputs
/backend/data/
/web/dist/
/web/node_modules/
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# ML artefacts and datasets are large build outputs, never source - with one
# deliberate exception. `active.onnx` is committed because deploy/docker-compose.yml
# runs the ML service with FAKE_MODE=0, and onnxruntime raises NoSuchFile at import
# when the artefact is absent, so a clone without it crash-loops the container and
# `make up` never classifies anything. 15 MB is a cheap price for a working clone.
/ml/models/*.onnx
!/ml/models/active.onnx
/ml/models/*.pt
/ml/models/*.pth
/ml/datasets/
/ml/runs/
# The corpora are build outputs; the code that evaluates against them is not.
# Both domain-gap evaluations live in ml/eval/ so the method behind every figure in
# docs/evidence/ is in version control even though its inputs are not.

# Local environment
.env
.env.local
*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.pytest_cache/

# ---------------------------------------------------------------- mobile
#
# Both apps are built on this machine; neither has a secret to protect
# (constraint 2 - no API keys anywhere), so what follows is build output and
# per-developer IDE state only.

# Gradle / Android
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/*/build/
android/*/*/build/
android/local.properties
android/build-logic/.gradle/
android/build-logic/*/build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.hprof
# The wrapper JAR is committed on purpose - it is what makes `./gradlew` reproducible
# on a clean machine. Do not add gradle-wrapper.jar here.

# Xcode / Swift
ios/*.xcodeproj/
ios/DerivedData/
ios/build/
ios/.swiftpm/
ios/Config/Local.xcconfig
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
.build/
# ios/*.xcodeproj is generated from ios/project.yml by XcodeGen and is not a source
# file. Note that this also excludes SwiftPM's Package.resolved, which lives inside it -
# so ios/project.yml pins GRDB to an exact version rather than a range, and that file is
# where dependency versions are reviewed.

# Self-signed demo certificates. The private key must never be committed;
# regenerate with deploy/tls/generate.sh.
deploy/tls/certs/

# Training run outputs: checkpoints, metrics, error galleries.
/ml/training/runs/
