# ---------------------------------------------------------------- mobile
#
# Both apps are built on this machine; neither has a secret to protect
# (constraint 2 — no API keys anywhere), so what follows is build output and
# per-developer IDE state only.

# Gradle / Android
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/*/build/
android/*/*/build/
android/local.properties
android/build-logic/.gradle/
android/build-logic/*/build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.hprof
# The wrapper JAR is committed on purpose — it is what makes `./gradlew` reproducible
# on a clean machine. Do not add gradle-wrapper.jar here.

# Xcode / Swift
ios/*.xcodeproj/
ios/DerivedData/
ios/build/
ios/.swiftpm/
ios/Config/Local.xcconfig
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
.build/
# ios/*.xcodeproj is generated from ios/project.yml by XcodeGen and is not a source
# file. Note that this also excludes SwiftPM's Package.resolved, which lives inside it —
# so ios/project.yml pins GRDB to an exact version rather than a range, and that file is
# where dependency versions are reviewed.

# Self-signed demo certificates. The private key must never be committed;
# regenerate with deploy/tls/generate.sh.
deploy/tls/certs/

# Training run outputs: checkpoints, metrics, error galleries.
/ml/training/runs/
