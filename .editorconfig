# EditorConfig — https://editorconfig.org
# Honoured by Xcode, Android Studio, VS Code and ktlint, so the IDE, the CLI and
# CI all format the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4

# ── ktlint ───────────────────────────────────────────────────────────────────
# `intellij_idea`, not `ktlint_official`. The official style enforces
# multiline-expression-wrapping, which rewrites idiomatic Compose
#     modifier = Modifier.fillMaxSize().padding(16.dp)
# into a four-line chain. That is not how Compose is written in Google's own
# samples and it makes every screen harder to read. `intellij_idea` matches what
# Android Studio produces on Reformat Code.
ktlint_code_style = intellij_idea

# @Composable functions are PascalCase by convention, which function-naming reads
# as a violation.
ktlint_standard_function-naming = disabled
# Design tokens (ReefSpacing.Md, LatticeCellGap) are PascalCase vals.
ktlint_standard_property-naming = disabled

ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.swift]
indent_size = 4

[*.{js,ts,vue,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.{xml,plist,xcconfig,pbxproj}]
indent_size = 4

[*.go]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,bash}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[gradle/libs.versions.toml]
indent_size = 4

[*.properties]
indent_size = 4
