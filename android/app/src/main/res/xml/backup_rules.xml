<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-Android-12 half of the same rule as data_extraction_rules.xml. Both are
     needed: `dataExtractionRules` is ignored below API 31, and this file is ignored above
     it, so stating only one leaves half the supported range unprotected.

     Nothing is backed up. The outbox holds unsent reef photographs and the token store
     holds session credentials; a restored outbox on another device would upload under
     whoever signs in there, attributing one diver's data to another. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
