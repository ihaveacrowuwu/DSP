<?xml version="1.0" encoding="utf-8"?>
<!-- A branching coral, drawn as strokes so it stays crisp at every density and needs no
     raster assets.

     This is the SAME drawing as ios/Muraka/Resources/Assets.xcassets/AppIcon.appiconset,
     which is generated from the same 100-unit geometry scaled by 1.08 to Android's 108
     viewport. The two stores show one mark, which is the point.

     Every tip stays inside the adaptive-icon safe zone (the centre 72 of 108), so no
     branch is clipped by a circular, squircle or teardrop mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Trunk, rising past the fork so the crown polyp reads separately -->
    <path
        android:pathData="M54,85.3 L54,50.8"
        android:strokeColor="#F0E7D9"
        android:strokeWidth="10.8"
        android:strokeLineCap="round" />
    <!-- Left branch -->
    <path
        android:pathData="M54,69.1 Q54,56.2 29.2,45.4"
        android:strokeColor="#F0E7D9"
        android:strokeWidth="9.5"
        android:strokeLineCap="round" />
    <!-- Right branch -->
    <path
        android:pathData="M54,64.8 Q54,51.8 78.8,41.0"
        android:strokeColor="#F0E7D9"
        android:strokeWidth="9.5"
        android:strokeLineCap="round" />

    <!-- Polyps -->
    <path
        android:pathData="M54,48.6 m-7.56,0 a7.56,7.56 0 1,0 15.12,0 a7.56,7.56 0 1,0 -15.12,0"
        android:fillColor="#F0E7D9" />
    <path
        android:pathData="M28.1,44.3 m-6.7,0 a6.7,6.7 0 1,0 13.4,0 a6.7,6.7 0 1,0 -13.4,0"
        android:fillColor="#F0E7D9" />
    <path
        android:pathData="M79.9,40.0 m-6.7,0 a6.7,6.7 0 1,0 13.4,0 a6.7,6.7 0 1,0 -13.4,0"
        android:fillColor="#F0E7D9" />
</vector>
