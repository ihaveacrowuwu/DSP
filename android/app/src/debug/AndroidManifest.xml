<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is a DEBUG-ONLY affordance for the local docker stack. It is scoped
     to the two hosts the emulator and simulator use, never granted app-wide, and never
     present in a release build (NFR4). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />
</manifest>
